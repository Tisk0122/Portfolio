# Canonical URL used for metadata, OGP, sitemap.xml and robots.txt.
# Set this to your production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. If set, a mailto: contact button appears in the Contact section.
# Leave unset to show "Coming soon" instead.
NEXT_PUBLIC_CONTACT_EMAIL=Tisk.address@gmail.com
